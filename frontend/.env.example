NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_COGNITO_DOMAIN=your-domain.auth.eu-west-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000
NEXT_PUBLIC_COGNITO_REGION=eu-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-2_ABC123

# Shared admin API key for local-only development flows. When set, the frontend will
# automatically attach this key to API requests and skip the Cognito sign-in screen.
NEXT_PUBLIC_ADMIN_API_KEY=local-admin-key

# Local development fallback (optional)
# Set to "true" to bypass Cognito and use mock tokens for local testing.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
NEXT_PUBLIC_MOCK_USER_EMAIL=demo@beyla.local
NEXT_PUBLIC_MOCK_USER_NAME=Sandbox User
